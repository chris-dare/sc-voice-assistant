# Sunshine Conversations (SunCo) app credentials
ZENDESK_APP_ID=
ZENDESK_KEY_ID=
ZENDESK_SECRET=
# US: https://api.smooch.io · EU: https://api.eu-1.smooch.io · Zendesk-hosted: https://<subdomain>.zendesk.com/sc
SUNCO_BASE_URL=https://api.smooch.io
# poll (no public URL needed) or webhook (needs SUNCO_WEBHOOK_SECRET and a public /webhooks/sunco)
SUNCO_DELIVERY=poll
SUNCO_WEBHOOK_SECRET=

# ElevenLabs (needs text_to_speech and speech_to_text permissions)
ELEVENLABS_API_KEY=
TTS_VOICE_ID=NWCYzEZIRjKG9C8z4tSK

# Pydantic Logfire (LOGFIRE_API_KEY is also accepted)
LOGFIRE_TOKEN=
ENVIRONMENT=dev

# Set a fixed secret so demo tokens survive restarts
AUTH_SECRET=
# Shared state for more than one instance: bot-message routing, call state (survives reconnects), rate
# limits, the TTS cache and the agent's semantic cache. Set the same value on the gateway and the agent service.
REDIS_URL=
# Per-user limits (429 with Retry-After). LIMIT_PER_MINUTE overrides the per-action defaults as JSON.
LIMITS_ENABLED=true
LIMIT_CONCURRENT_CALLS=2
LIMIT_DAILY_VOICE_MINUTES=60
# How long a call's agent state is kept after the last turn
CALL_STATE_TTL_S=1800
# Run with a fake bot, STT and TTS (no keys or network needed)
MOCK_PROVIDERS=false

# Agentic mode: an LLM in front of SunCo that calls Zigi as a tool (design 5.8)
# AGENT_MODE_ENABLED is the feature flag; OPENROUTER_API_KEY is only the LLM credential.
AGENT_MODE_ENABLED=false
OPENROUTER_API_KEY=
AGENT_MODEL=openai/gpt-6-luna
AGENT_FALLBACK_MODELS=["openai/gpt-5.6-luna"]
# The separate agent service (empty: run it in-process) and its bearer token
AGENT_SERVICE_URL=
AGENT_SERVICE_TOKEN=
# Agent service: reuse Zigi's answers to general questions asked again (never personal or account questions)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_S=21600
SEMANTIC_CACHE_THRESHOLD=0.9
# relay (Chatbot relay) or agent (Agentic); the voice screen has a switch for both
VOICE_MODE_DEFAULT=relay
# Client sends silence to STT until its VAD hears speech (keeps background noise out)
NOISE_GATE=true
# Client learns the caller's speaking level and ignores quieter voices (others in the room)
VOICE_FOCUS=true
# Testing only: log what the caller and the agent said to Logfire (keep off for real customers)
LOG_CONVERSATION_TEXT=false
